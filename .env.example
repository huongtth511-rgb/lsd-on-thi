# Run npm run setup to create local credentials. Never commit .env.
AUTH_USERNAME=admin
# Format: scrypt:<32 hex salt>:<128 hex hash>. Generated by npm run setup.
AUTH_PASSWORD_HASH=
# On Railway set NODE_ENV=production and APP_ORIGIN to your HTTPS domain.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
